# Copy this file to .env and fill in real values

NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017/bangladesh-landscape

# Generate a long random string, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173

# --- Phase 3: AI tour plans ---
# Without ANTHROPIC_API_KEY the server uses a deterministic mock generator (dev mode)
# ANTHROPIC_API_KEY=
# PLAN_MODEL=claude-opus-5

# Public base URL of this API server (used in payment callback URLs)
SERVER_URL=http://localhost:5000

# --- Phase 3: payments (SSLCommerz) ---
# Without credentials the mock gateway is used (dev mode)
# SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASSWORD=
# SSLCOMMERZ_LIVE=false

# PDF rendering uses installed Google Chrome; override the path if needed
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# --- Phase 4+ ---
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
