# Copy this file to .env and fill in real values

NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017/bangladesh-landscape

# Generate a long random string, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173

